public String reverseWordsInASentence(String sentence){
    //your flawless code here
    if(sentence==null){
        return null;
    }else if(sentence==''){
        return '';
    }
    List<String> splitedWords = sentence.split(' ');
    String revertedSentence = '';
    for(Integer wordIndex = splitedWords.size()-1; wordIndex>= 0; wordIndex--){
        
        if(wordIndex==0){
            revertedSentence = revertedSentence + splitedWords[wordIndex];    
        }else{
            revertedSentence = revertedSentence + splitedWords[wordIndex] + ' ';
        }
    }

    return revertedSentence;
}