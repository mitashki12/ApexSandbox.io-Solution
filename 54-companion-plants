public Boolean companionPlants(String plant1, String plant2) {
    //code here
    switch on plant1 {
        when 'lettuce' {
            if(plant2=='cucumbers'||plant2=='onions'){
                return true;
            }
        }
        when 'onions' {
            if(plant2=='lettuce'||plant2=='carrots'||plant2=='tomatoes'){
                return true;
            }
        }
        when 'cucumbers' {
            if(plant2=='lettuce'){
                return true;
            }
        }
        when 'carrots' {
            if(plant2=='onions'){
                return true;
            }
        }
        when 'tomatoes' {
            if(plant2=='onions'){
                return true;
            }
        }
        when else {
            return false;
        }
    }
    return false;
}