public Set<Id> accountIds(List<Opportunity> opps) {
    //code here
    Set<Id> resultSet = new Set<Id>();
    if(!opps.isEmpty()){
        for(Opportunity currentOpp: opps){
            if(currentOpp.AccountId!=null){
                resultSet.add(currentOpp.AccountId);
            }
        }
    }
    return resultSet;
}