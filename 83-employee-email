public String employeeEmail(Map<String, String> employeeIdToEmail, String employeeId) {
    //code here
    String employeeEmail = employeeIdToEmail!=null ? employeeIdToEmail.get(employeeId) : 'info@apexsandbox.io';
    if(employeeEmail==null){
        employeeEmail = 'info@apexsandbox.io'; 
    }
    return employeeEmail;
}