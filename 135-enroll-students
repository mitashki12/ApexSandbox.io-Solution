public void enrollStudents(List<String> emails, String className) {
    // code here
    List<apxio__Student__c> students = [
        SELECT
            Id
        FROM
            apxio__Student__c
        WHERE
            apxio__Email__c IN :emails
    ];

    List classes = [
        SELECT
            Id
        FROM
            apxio__Class__c
        WHERE
            Name = :className
    ];

    List<apxio__Class_Enrollment__c> enrollments = new List<apxio__Class_Enrollment__c>();

    for(apxio__Student__c currentStudent : students){
        apxio__Class_Enrollment__c currentEnrollment = new apxio__Class_Enrollment__c(apxio__Student__c = currentStudent.Id, apxio__Offered_Class__c = classes[0].Id);
        enrollments.add(currentEnrollment);
    }
    insert enrollments;
}