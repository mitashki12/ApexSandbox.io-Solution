public Integer secondLargest(List<Integer> numbers) {
    //code here
    Integer currentLargestNumber = numbers[0];
    Integer secondLargestNumber;
    for(Integer i=1;i<numbers.size();i++){
        if(numbers[i]>currentLargestNumber){
            secondLargestNumber = currentLargestNumber;
            currentLargestNumber=numbers[i];
            
        }
    }
    return secondLargestNumber;
}