public boolean isSorted(List<Integer> numbers) {
    //code here
    if(numbers.size()<=3){
        return true;
    }

    if(numbers[0]<numbers[1]){
        for(Integer i=2;i<numbers.size();i++){
            if(numbers[i]<numbers[i-1]){
                return false;
            }
        }
    }else if(numbers[0]>numbers[1]){
        for(Integer i=2;i<numbers.size();i++){
            if(numbers[i]>numbers[i-1]){
                return false;
            }
        }
    }
    return true;
}