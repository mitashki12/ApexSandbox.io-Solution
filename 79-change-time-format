public String changeTimeFormat(String strTime) {
    //code here
    List<String> splitedTime = strTime.split(':');
    String amOrPm;
    Integer hour = Integer.valueOf(splitedTime[0]);
    Integer minute = Integer.valueOf(splitedTime[1]);
    if( hour>=0 && hour<12 ){
        amOrPm = 'AM';
    }else{
        amOrPm = 'PM';
        hour = hour-12;
    }
    String formattedTime = String.format('{0, number, 00}:{1, number, 00} {3}',hour,minute,amOrPm);
    return  formattedTime;  
}