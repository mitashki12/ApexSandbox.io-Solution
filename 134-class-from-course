public Id classFromCourse(String courseName) {
    // code here
    List<apxio__Course__c> retrievedCourses = [
        SELECT
            Id,
            Name
        FROM
            apxio__Course__c
        WHERE
            Name = :courseName
    ];
    if(retrievedCourses.size()>0){
        apxio__Class__c newClass = new apxio__Class__c(Name = courseName, apxio__Course__c = retrievedCourses[0].Id);
        insert newClass;

        return newClass.Id;
    }else{
        return null;
    }
}