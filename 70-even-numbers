public List<Integer> evenNumbers(Integer n) {
    //code here
    List<Integer> evenNumbers = new List<Integer>();
    Integer indexOfEvenNumbers = 0;
    for(Integer currentNumber=1;indexOfEvenNumbers<n;currentNumber++){
        if(Math.mod(currentNumber,2)==0){
            indexOfEvenNumbers++;
            evenNumbers.add(currentNumber);
        }
    }
    return evenNumbers;
}