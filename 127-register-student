public String registerStudent(String name, String phone, String email) {
    // code here

    apxio__Student__c student = new apxio__Student__c(
        Name = name,
        apxio__Phone__c = phone,
        apxio__Email__c = '' + email
    );

    upsert student;
    List<apxio__Student__c> quriedStudentList = [SELECT apxio__Registration_Number__c FROM apxio__Student__c WHERE Name = name];
    return ''+quriedStudentList[0].apxio__Registration_Number__c;
}