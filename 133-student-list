public void insertStudents(List<String> studentNames, List<String> studentEmails) {
    // code here
    List<apxio__Student__c> studentsToInsert = new List<apxio__Student__c>();

    for(Integer i=0;i<studentNames.size();i++){
        apxio__Student__c currentStudent = new apxio__Student__c(Name = studentNames[i],apxio__Email__c = studentEmails[i]);
        studentsToInsert.add(currentStudent);
    }

    insert studentsToInsert;
}